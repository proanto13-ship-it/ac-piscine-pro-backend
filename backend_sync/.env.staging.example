APP_ENV=staging
PORT=8000
DATABASE_URL=sqlite:////data/hydrazur/sync_v2_staging.sqlite3
SYNC_V2_MEDIA_DIR=/data/hydrazur/media
AUTH_SECRET=change-me-staging-auth-secret
ADMIN_SEED_TOKEN=change-me-staging-admin-token
CORS_ALLOWED_ORIGINS=https://staging.hydrazur.app
DEMO_SEED_ENABLED=false
SYNC_V2_ALLOW_PUBLIC_BOOTSTRAP=false
SYNC_V2_LOG_LEVEL=INFO
